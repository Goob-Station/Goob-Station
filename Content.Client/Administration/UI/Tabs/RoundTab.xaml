        Columns="3">
        <cc:CommandButton Command="startround" Text="{Loc administration-ui-round-tab-start-round}" NeedsConfirm="True" /> <!-- Goob - add confirm -->
        <cc:CommandButton Command="endround" Text="{Loc administration-ui-round-tab-end-round}" NeedsConfirm="True" /> <!-- Goob - add confirm -->
        <cc:CommandButton Command="restartround" Text="{Loc administration-ui-round-tab-restart-round}" NeedsConfirm="True" /> <!-- Goob - add confirm -->
