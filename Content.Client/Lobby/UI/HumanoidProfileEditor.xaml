<!-- Goob -->
<BoxContainer xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:humanoid="clr-namespace:Content.Client.Humanoid"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
         xmlns:hull="clr-namespace:Content.Goobstation.UIKit.UserInterface.Lobby;assembly=Content.Goobstation.UIKit"
         xmlns:goob="clr-namespace:Content.Goobstation.UIKit.UserInterface.Humanoid;assembly=Content.Goobstation.UIKit"
         HorizontalExpand="True"
         SeparationOverride="10">
    <BoxContainer Orientation="Vertical" MinWidth="300" SeparationOverride="6">
        <PanelContainer StyleClasses="HullInset" VerticalExpand="True">
            <SpriteView Name="SpriteView" Scale="8 8" Margin="4"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="4">
            <Button Name="SpriteRotateLeft" Text="◀" StyleClasses="HullPlate" />
            <Button Name="SpriteRotateRight" Text="▶" StyleClasses="HullPlate" />
            <Button Name="ShowClothes" Pressed="True" ToggleMode="True"
                    Text="{Loc 'humanoid-profile-editor-clothing-show'}" StyleClasses="HullTab" />
        </BoxContainer>
        <PanelContainer StyleClasses="HullCard">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="8">
                    <hull:HazardStripe>
                        <Button Name="SaveButton" Text="{Loc 'humanoid-profile-editor-save-button'}"
                                StyleClasses="HullReady" MinWidth="120" MinHeight="34" Margin="4" />
                    </hull:HazardStripe>
                    <Button Name="ResetButton" Disabled="True" Text="{Loc 'humanoid-profile-editor-reset-button'}"
                            StyleClasses="HullPlate" VerticalAlignment="Center" />
                </BoxContainer>
                <GridContainer Columns="2" HSeparationOverride="4" VSeparationOverride="4">
                    <Button Name="ImportButton" Text="{Loc 'humanoid-profile-editor-import-button'}" StyleClasses="HullPlate" HorizontalExpand="True" />
                    <Button Name="ExportButton" Text="{Loc 'humanoid-profile-editor-export-button'}" StyleClasses="HullPlate" HorizontalExpand="True" />
                    <Button Name="ExportImageButton" Text="{Loc 'humanoid-profile-editor-export-image-button'}" StyleClasses="HullPlate" HorizontalExpand="True" />
                    <Button Name="OpenImagesButton" Text="{Loc 'humanoid-profile-editor-open-image-button'}" StyleClasses="HullPlate" HorizontalExpand="True" />
                </GridContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>

    <ScrollContainer HScrollEnabled="False" VScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
    <TabContainer Name="TabContainer" VerticalExpand="True" HorizontalExpand="True" StyleClasses="HullTabs">
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="6">
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Label Text="{Loc 'humanoid-profile-editor-name-label'}" StyleClasses="HullFieldLabel" MinWidth="130" VAlign="Center" />
                    <LineEdit Name="NameEdit" StyleClasses="HullField" HorizontalExpand="True" VerticalAlignment="Center" />
                    <Button Name="NameRandomize" Text="{Loc 'humanoid-profile-editor-name-random-button'}" StyleClasses="HullPlate" />
                </BoxContainer>
                <RichTextLabel Name="WarningLabel" HorizontalExpand="True" Margin="136 0 0 0" />

                <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0 8 0 0">
                    <Label Text="{Loc 'humanoid-profile-editor-species-label'}" StyleClasses="HullFieldLabel" VAlign="Center" />
                    <TextureButton Name="SpeciesInfoButton" Scale="0.3 0.3" VerticalAlignment="Center"
                                   ToolTip="{Loc 'humanoid-profile-editor-guidebook-button-tooltip'}" />
                </BoxContainer>
                <PanelContainer StyleClasses="HullInset">
                    <goob:SpeciesGallery Name="SpeciesButton" Margin="4" />
                </PanelContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0 4 0 0">
                    <Label Text="{Loc 'humanoid-profile-editor-age-label'}" StyleClasses="HullFieldLabel" MinWidth="130" VAlign="Center" />
                    <Slider Name="AgeSlider" StyleClasses="HullSlider" Rounded="True" HorizontalExpand="True" VerticalAlignment="Center" />
                    <LineEdit Name="AgeEdit" StyleClasses="HullField" MinSize="56 0" />
                    <Label Name="AgeBracketLabel" StyleClasses="HullFieldLabel" MinWidth="60" VAlign="Center" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Label Text="{Loc 'humanoid-profile-editor-sex-label'}" StyleClasses="HullFieldLabel" MinWidth="130" VAlign="Center" />
                    <hull:SegmentedOptions Name="SexButton" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Label Text="{Loc 'humanoid-profile-editor-pronouns-label'}" StyleClasses="HullFieldLabel" MinWidth="130" VAlign="Center" />
                    <hull:SegmentedOptions Name="PronounsButton" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="6" Visible="False" Name="BarksContainer">
                    <Label Text="{Loc 'humanoid-profile-editor-voice-label'}" StyleClasses="HullFieldLabel" MinWidth="130" VAlign="Top" />
                    <PanelContainer StyleClasses="HullInset" HorizontalExpand="True">
                        <ScrollContainer HScrollEnabled="False" ReturnMeasure="True" MaxHeight="180">
                            <hull:VoiceList Name="BarkVoiceButton" Margin="4" />
                        </ScrollContainer>
                    </PanelContainer>
                </BoxContainer>

                <Label Text="{Loc 'humanoid-profile-editor-section-arrival'}" StyleClasses="HullSection" Margin="0 8 0 0" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Label Text="{Loc 'humanoid-profile-editor-spawn-priority-label'}" StyleClasses="HullFieldLabel" MinWidth="130" VAlign="Center" />
                    <hull:SegmentedOptions Name="SpawnPriorityButton" />
                </BoxContainer>

                <Button Name="RandomizeEverythingButton" HorizontalAlignment="Left" Margin="0 14 0 0"
                        Text="{Loc 'humanoid-profile-editor-randomize-everything-button'}" StyleClasses="HullPlate" />
            </BoxContainer>
        </ScrollContainer>

            <BoxContainer Name="AppearanceBox" Orientation="Vertical" Margin="12 10" SeparationOverride="6" VerticalExpand="True">
                <PanelContainer StyleClasses="HullCard">
                <ScrollContainer Name="BodyScroll" HScrollEnabled="False" ReturnMeasure="True" MaxHeight="360" Margin="8 6 4 6">
                    <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="0 0 8 0">
                    <Label Text="{Loc 'humanoid-profile-editor-section-body'}" StyleClasses="HullSection" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <Label Name="HeightLabel" StyleClasses="HullFieldLabel" MinWidth="130" VAlign="Center" />
                        <Slider Name="HeightSlider" StyleClasses="HullSlider" MinValue="0.5" Value="1" MaxValue="1.5" HorizontalExpand="True" VerticalAlignment="Center" />
                        <Button Name="HeightReset" Text="{Loc 'ui-options-bind-reset'}" StyleClasses="HullPlate" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <Label Name="WidthLabel" StyleClasses="HullFieldLabel" MinWidth="130" VAlign="Center" />
                        <Slider Name="WidthSlider" StyleClasses="HullSlider" MinValue="0.5" Value="1" MaxValue="1.5" HorizontalExpand="True" VerticalAlignment="Center" />
                        <Button Name="WidthReset" Text="{Loc 'ui-options-bind-reset'}" StyleClasses="HullPlate" />
                    </BoxContainer>
                    <Label Name="WeightLabel" StyleClasses="HullFieldLabel" />

                    <Label Text="{Loc 'humanoid-profile-editor-skin-color-label'}" StyleClasses="HullSection" Margin="0 8 0 0" />
                    <hull:ColorTrackSlider Name="Skin" HorizontalExpand="True" MinValue="0" MaxValue="100" Value="20" MinHeight="22" />
                    <BoxContainer Name="RgbSkinColorContainer" Visible="False" Orientation="Vertical" HorizontalExpand="True" />
                    <BoxContainer Name="SkinSwatches" Orientation="Horizontal" SeparationOverride="4" />

                    <Label Text="{Loc 'humanoid-profile-editor-eyes-label'}" StyleClasses="HullSection" Margin="0 8 0 0" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                        <BoxContainer Name="EyeSwatches" Orientation="Horizontal" SeparationOverride="4" />
                        <Button Name="EyeCustomButton" ToggleMode="True" StyleClasses="HullTab" Text="{Loc 'marking-tiles-custom'}" />
                    </BoxContainer>
                    <humanoid:EyeColorPicker Name="EyeColorPicker" Visible="False" />
                    </BoxContainer>
                </ScrollContainer>
                </PanelContainer>

                <BoxContainer Name="HairSection" Orientation="Vertical" SeparationOverride="6" Margin="0 8 0 0" VerticalExpand="True">
                    <Label Text="{Loc 'humanoid-profile-editor-section-hair'}" StyleClasses="HullSection" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                        <Button Name="HairTabButton" ToggleMode="True" Pressed="True" StyleClasses="HullTab" />
                        <Button Name="FacialHairTabButton" ToggleMode="True" StyleClasses="HullTab" />
                    </BoxContainer>
                    <goob:MarkingTilePicker Name="HairStylePicker" Category="Hair" />
                    <goob:MarkingTilePicker Name="FacialHairPicker" Category="FacialHair" Visible="False" />
                </BoxContainer>
            </BoxContainer>

        <!-- Jobs -->
        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="{Loc 'humanoid-profile-editor-jobs-unavailable-label'}" StyleClasses="HullFieldLabel" VAlign="Center" />
                <hull:SegmentedOptions Name="PreferenceUnavailableButton" />
                <Control HorizontalExpand="True" />
                <Button Name="HideLockedJobsCheck" ToggleMode="True" StyleClasses="HullTab" Text="{Loc 'humanoid-profile-editor-hide-locked-jobs'}" />
            </BoxContainer>
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="JobList" Orientation="Vertical" />
            </ScrollContainer>
        </BoxContainer>

        <!-- Antags -->
        <BoxContainer Orientation="Vertical" Margin="10">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="AntagList" Orientation="Vertical" />
            </ScrollContainer>
        </BoxContainer>

        <!-- Traits -->
        <BoxContainer Orientation="Vertical" Margin="10">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="TraitsList" Orientation="Vertical" />
            </ScrollContainer>
        </BoxContainer>

        <!-- Markings -->
        <BoxContainer Name="MarkingsTab" Orientation="Vertical" Margin="10">
            <goob:MarkingGridPicker Name="Markings" IgnoreCategories="Hair,FacialHair" />
        </BoxContainer>
    </TabContainer>
    </ScrollContainer>
</BoxContainer>
