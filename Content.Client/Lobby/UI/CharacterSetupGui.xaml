<!-- Goob -->
<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         xmlns:hull="clr-namespace:Content.Goobstation.UIKit.UserInterface.Lobby;assembly=Content.Goobstation.UIKit"
         VerticalExpand="True">
    <hull:HullPanel Name="BackgroundPanel">
        <BoxContainer Orientation="Vertical" Margin="14 9 14 22" SeparationOverride="8">
            <hull:HazardStripe MinHeight="6" Margin="11 0 11 9" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Label Text="{Loc 'character-setup-gui-character-setup-label'}"
                       StyleClasses="HullHeading" VAlign="Center" HorizontalExpand="True" />
                <Button Name="StatsButton"
                        Text="{Loc 'character-setup-gui-character-setup-stats-button'}"
                        StyleClasses="HullPlate" />
                <cc:CommandButton Name="AdminRemarksButton"
                                  Command="adminremarks"
                                  Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}"
                                  StyleClasses="HullPlate" />
                <Button Name="RulesButton"
                        Text="{Loc 'character-setup-gui-character-setup-rules-button'}"
                        StyleClasses="HullPlate" />
                <Button Name="CloseButton"
                        Access="Public"
                        Text="{Loc 'character-setup-gui-back-to-lobby'}"
                        StyleClasses="HullPlate" />
            </BoxContainer>
            <PanelContainer StyleClasses="HullInset">
                <ScrollContainer HScrollEnabled="True" VScrollEnabled="False" Margin="4" MinHeight="146">
                    <BoxContainer Name="Characters" Orientation="Horizontal" SeparationOverride="6" Margin="0 0 0 4" />
                </ScrollContainer>
            </PanelContainer>
            <BoxContainer Name="CharEditor" HorizontalExpand="True" VerticalExpand="True" />
        </BoxContainer>
    </hull:HullPanel>
</Control>
