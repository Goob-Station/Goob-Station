<!-- Goob -->
<ContainerButton xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         StyleClasses="HullSlot"
         SetWidth="132">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  SeparationOverride="2"
                  Name="InternalHBox">
        <SpriteView Scale="2 2"
                    OverrideDirection="South"
                    Name="View"
                    SetSize="64 64"
                    HorizontalAlignment="Center"/>
        <Label Name="DescriptionLabel"
               ClipText="True"
               Align="Center"
               HorizontalExpand="True"/>
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" MinHeight="24">
            <Button Name="DeleteButton"
                    StyleClasses="HullPlate"
                    Text="{Loc 'character-setup-gui-character-picker-button-delete-button'}"/>
            <Button Name="ConfirmDeleteButton"
                    Text="{Loc 'character-setup-gui-character-picker-button-confirm-delete-button'}"
                    Visible="False"
                    StyleClasses="HullDanger"/>
        </BoxContainer>
    </BoxContainer>
</ContainerButton>
