reagent-name-mute-serum = mute serum
reagent-desc-mute-serum = A purified derivative of mute toxin that soothes minor wounds and can restore a patient's voice.
reagent-name-mutol = mutol
reagent-desc-mutol = An electrolyzed mute toxin byproduct that helps the body absorb oxygen and moves the limbs a little faster.
reagent-name-mutonin = mutonin
reagent-desc-mutonin = A volatile mute-toxin stimulant. It dulls pain and accelerates movement, but overdoses are toxic.
