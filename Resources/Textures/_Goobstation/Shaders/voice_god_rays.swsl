light_mode unshaded;
blend_mode add;

uniform highp vec4 rayColor;
uniform highp float intensity;

highp float rayPattern(highp float angle, highp float time) {
    highp float a = sin(angle * 23.0 + time * 0.37);
    highp float b = sin(angle * 37.0 - time * 0.23 + 1.7);
    highp float c = sin(angle * 61.0 + time * 0.51 + 4.1);
    highp float d = sin(angle * 11.0 - time * 0.13 + 2.3);
    highp float value = (a * 0.35 + b * 0.3 + c * 0.2 + d * 0.15) * 0.5 + 0.5;
    return smoothstep(0.42, 0.82, value);
}

void fragment() {
    highp vec2 size = 1.0 / SCREEN_PIXEL_SIZE;
    highp float time = TIME;
    highp vec2 origin = vec2(size.x * (0.5 + 0.06 * sin(time * 0.17)), size.y * 1.35);
    highp vec2 dir = FRAGCOORD.xy - origin;
    highp float angle = atan(dir.x, -dir.y);

    highp float height = clamp(FRAGCOORD.y / size.y, 0.0, 1.0);
    highp float falloff = pow(height, 1.7);
    highp float spread = 1.0 - smoothstep(0.75, 1.25, abs(angle));
    highp float shimmer = 0.85 + 0.15 * sin(time * 1.3 + angle * 7.0);

    highp float light = (rayPattern(angle, time) * 0.8 + 0.2) * falloff * spread * shimmer;
    COLOR = vec4(rayColor.rgb, clamp(light * intensity, 0.0, 1.0));
}
