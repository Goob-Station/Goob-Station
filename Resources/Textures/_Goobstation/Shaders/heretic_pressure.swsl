light_mode unshaded;

uniform highp float strength;
uniform highp float flowSpeed;
uniform highp vec4 tint;
uniform highp float shock;

highp float hFbm(highp vec2 uv) {
    highp float amp = 0.5;
    highp float freq = 3.0;
    highp float value = 0.0;

    for (int i = 0; i < 4; i++) {
        value += amp * zNoise(freq * uv);
        amp *= 0.5;
        freq *= 2.0;
    }

    return value;
}

highp float hash2(highp vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment() {
    highp vec2 suv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
    highp float aspect = SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x;

    highp vec2 p = vec2((suv.x - 0.5) * 2.0 * aspect, (suv.y - 0.5) * 2.0);
    highp float r = length(p) + 0.000001;
    highp vec2 n = p / r;
    highp float t = TIME * flowSpeed;
    highp float ca = cos(t * 0.05);
    highp float sa = sin(t * 0.05);
    highp vec2 rn = vec2(n.x * ca - n.y * sa, n.x * sa + n.y * ca);
    highp float w = hFbm(vec2(p.x * 0.9 + t * 0.06, p.y * 0.9 - t * 0.05)) - 0.5;
    highp vec2 warp = vec2(w, hFbm(vec2(p.y * 0.9 + 5.7, p.x * 0.9 + 3.1)) - 0.5);
    highp float coarse = hFbm(rn * 1.7 + warp * 1.1);
    highp float fine = hFbm(rn * 5.0 + warp * 1.6);
    highp float streak = pow(clamp((coarse * 0.65 + fine * 0.45 - 0.34) * 2.4, 0.0, 1.0), 1.3);
    highp float run = 0.55 + 0.45 * sin(r * 5.5 - t * 2.6 + streak * 7.0);
    highp float edge = smoothstep(0.46, 1.30, r);
    highp float iris = smoothstep(0.30, 1.30, r + (coarse - 0.5) * 0.34);
    highp float breath = 0.85 + 0.15 * sin(t * 1.4);
    highp float ang = atan(rn.y, rn.x);
    highp vec2 cell = vec2(ang * 7.0, r * 9.0 - t * 0.8);
    highp vec2 cellId = floor(cell);
    highp float mote = step(0.955, hash2(cellId));
    mote *= smoothstep(0.42, 0.06, distance(fract(cell), vec2(0.5)));
    mote *= smoothstep(0.25, 1.0, r);
    highp vec3 deep = tint.rgb * tint.rgb * 0.55;
    highp vec3 hot = min(tint.rgb * 1.25 + 0.18, vec3(1.0));
    highp float body = streak * edge * run * breath;
    highp float ramp = pow(clamp(body * 1.8, 0.0, 1.0), 1.5);
    highp vec3 glow = deep * body * 0.95 + hot * body * ramp * 0.85;
    glow += hot * mote * 0.95;
    glow *= strength;
    if (shock >= 0.0 && shock <= 1.0) {
        highp float front = (r - shock * 2.6) / 0.055;
        highp float band = exp(-front * front);
        highp float fade = pow(clamp(1.0 - shock, 0.0, 1.0), 1.8);
        glow += (tint.rgb * 0.85 + 0.15) * band * fade * (0.6 + 0.5 * streak) * 0.55 * strength;
    }

    highp float dark = clamp(iris * 0.86 * strength * breath, 0.0, 0.94);
    highp float lum = clamp(max(max(glow.r, glow.g), glow.b), 0.0, 1.0);
    highp float alpha = clamp(dark + lum, 0.0, 1.0);
    COLOR = vec4(glow / max(alpha, 0.001), alpha);
}
