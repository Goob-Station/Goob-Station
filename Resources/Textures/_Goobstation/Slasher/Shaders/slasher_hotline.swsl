
uniform highp float speed;
uniform highp float phase;

highp float hash(highp float n)
{
    return fract(sin(n * 12.9898) * 43758.5453);
}

void fragment()
{
    highp float t = TIME * speed + phase;
    highp float a = t * 0.81681; // magenta <-> cyan oscillator
    highp float b = t * 0.45293; // red splash + brightness swell oscillator

    highp vec3 col = mix(vec3(1.0, 0.0, 1.0), vec3(0.0, 1.0, 1.0), 0.5 + 0.5 * cos(a));
    col = mix(col, vec3(1.0, 0.0, 0.0), 0.125 - 0.125 * sin(b));
    col *= 0.75 - 0.25 * sin(b);

    col *= FRAGCOORD.y * SCREEN_PIXEL_SIZE.y;

    highp float lineHeight = 5.0; // px per pattern row
    highp float jitter = floor(hash(floor(TIME * 60.0) + 0.37) * 32.0);
    highp float y = FRAGCOORD.y / lineHeight + jitter;
    highp float rowNoise = hash(mod(floor(y), 32.0) + 1.0);
    highp float line = step(rowNoise, 0.5) * mix(8.0, 11.0, step(0.25, rowNoise)) / 255.0;
    highp float f = fract(y);
    highp float profile = smoothstep(0.0, 0.35, f) * (1.0 - smoothstep(0.65, 1.0, f));
    col = max(col - vec3(line * profile), vec3(0.0));

    COLOR = vec4(col, 1.0);
}
