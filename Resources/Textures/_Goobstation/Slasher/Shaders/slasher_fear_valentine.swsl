#include "/Textures/_Goobstation/Slasher/Shaders/slasher_valentine_shared.swsl"

uniform sampler2D SCREEN_TEXTURE;
uniform highp float intensity;

highp mat2 rot(highp float a)
{
    highp float c = cos(a);
    highp float s = sin(a);
    return mat2(c, s, -s, c);
}

highp vec4 comp4(highp vec4 dst, highp vec4 src)
{
    return src + dst * (1.0 - src.a);
}

highp vec3 over(highp vec3 dst, highp vec4 src)
{
    return dst * (1.0 - src.a) + src.rgb;
}

highp vec4 heartCell(highp vec2 id, highp vec2 local, highp float size, highp float soft,
                     highp float fill, highp float seed, highp float t)
{
    highp float r1 = hash(id + seed);
    if (r1 > fill)
        return vec4(0.0);

    highp float r2 = hash(id + seed + 17.3);
    highp float r3 = hash(id + seed + 41.9);

    highp vec2 c = vec2(0.5 + (r2 - 0.5) * 0.46 + 0.09 * sin(t * 1.4 + r3 * 6.28),
                        0.5 + (r3 - 0.5) * 0.46);
    highp vec2 p = (local - c) / (size * (0.6 + 0.8 * r2));
    p.y = -p.y;
    p = rot((r3 - 0.5) * 0.9 + sin(t * 0.8 + r1 * 6.28) * 0.16) * p;

    highp float d = sdHeart(p);
    highp float core = smoothstep(soft, -soft, d);
    highp float glow = exp(max(d, 0.0) * -5.5);

    highp vec3 col = mix(WINE, BLUSH, clamp(0.55 - p.y * 0.42, 0.0, 1.0));
    col += GLINT * smoothstep(0.55, 0.0, length(p - vec2(-0.34, 0.52)));

    highp float twinkle = 0.7 + 0.3 * sin(t * 2.1 + r1 * 6.28);
    return vec4((col * core + ROSE * glow * 0.7) * twinkle, core * twinkle);
}

highp vec4 heartLayer(highp vec2 sp, highp float cell, highp float fall, highp float size,
                      highp float soft, highp float fill, highp float seed, highp float t)
{
    highp vec2 gv = sp / cell;
    gv.y += t * fall;
    highp vec2 id = floor(gv);
    highp vec2 f = fract(gv);

    highp vec4 acc = vec4(0.0);
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            if (x == 0 && y == 0)
                continue;

            highp vec2 o = vec2(float(x), float(y));
            acc = comp4(acc, heartCell(id + o, f - o, size, soft, fill, seed, t));
        }
    }

    return comp4(acc, heartCell(id, f, size, soft, fill, seed, t));
}

highp float sparkles(highp vec2 sp, highp float t)
{
    highp vec2 gv = sp / 0.075;
    gv.y += t * 0.03;
    highp vec2 id = floor(gv);
    highp vec2 f = fract(gv) - 0.5;

    highp float r = hash(id + 7.31);
    if (r < 0.86)
        return 0.0;

    highp vec2 q = f - (vec2(hash(id + 1.1), hash(id + 2.2)) - 0.5) * 0.5;

    highp float tw = max(0.0, sin(t * 4.0 + r * 40.0));
    tw = tw * tw * tw;

    highp float point = smoothstep(0.05, 0.0, length(q));
    highp float streak = smoothstep(0.20, 0.0, abs(q.x)) * smoothstep(0.018, 0.0, abs(q.y))
                       + smoothstep(0.20, 0.0, abs(q.y)) * smoothstep(0.018, 0.0, abs(q.x));
    return (point + streak * 0.7) * tw;
}

void fragment()
{
    highp float i = clamp(intensity, 0.0, 1.0);
    highp vec2 uv = UV;
    highp vec2 px = SCREEN_PIXEL_SIZE;

    highp float pulse = mix(heartbeat(TIME * 0.70), heartbeat(TIME * 1.30), smoothstep(0.45, 0.95, i));
    highp float beat = 0.85 + 0.15 * pulse;

    highp vec2 caDir = uv - 0.5;
    highp float ca = i * (3.0 + 7.0 * i) * length(caDir);
    highp vec3 scr;
    scr.r = zTextureSpec(SCREEN_TEXTURE, uv + caDir * px * ca).r;
    scr.g = zTextureSpec(SCREEN_TEXTURE, uv).g;
    scr.b = zTextureSpec(SCREEN_TEXTURE, uv - caDir * px * ca).b;

    highp float rad = 3.0 + 5.0 * i;
    highp vec3 bloom = vec3(0.0);
    bloom += zTextureSpec(SCREEN_TEXTURE, uv + vec2( 1.0,  0.0) * px * rad).rgb;
    bloom += zTextureSpec(SCREEN_TEXTURE, uv + vec2(-1.0,  0.0) * px * rad).rgb;
    bloom += zTextureSpec(SCREEN_TEXTURE, uv + vec2( 0.0,  1.0) * px * rad).rgb;
    bloom += zTextureSpec(SCREEN_TEXTURE, uv + vec2( 0.0, -1.0) * px * rad).rgb;
    bloom += zTextureSpec(SCREEN_TEXTURE, uv + vec2( 0.7,  0.7) * px * rad).rgb;
    bloom += zTextureSpec(SCREEN_TEXTURE, uv + vec2(-0.7,  0.7) * px * rad).rgb;
    bloom += zTextureSpec(SCREEN_TEXTURE, uv + vec2( 0.7, -0.7) * px * rad).rgb;
    bloom += zTextureSpec(SCREEN_TEXTURE, uv + vec2(-0.7, -0.7) * px * rad).rgb;
    bloom *= 0.125;
    highp vec3 glow = bloom * bloom * (0.28 * i);
    highp vec3 color = vec3(1.0) - (vec3(1.0) - scr) * (vec3(1.0) - glow);

    highp float luma = dot(color, vec3(0.299, 0.587, 0.114));
    highp vec3 tinted = color * vec3(1.08, 0.50, 0.70);
    tinted = mix(tinted, vec3(luma) * ROSE * 1.25, 0.25);
    color = mix(color, tinted, i);

    highp float aspect = px.y / px.x;
    highp vec2 sp = vec2(uv.x * aspect, uv.y);
    highp vec2 ctr = vec2(0.5 * aspect, 0.5);
    highp float dist = length(sp - ctr) / length(ctr);

    highp float sideBand = 1.0 - smoothstep(0.0, 0.24, min(uv.x, 1.0 - uv.x));
    highp float radial = smoothstep(mix(0.80, 0.55, i), 1.05, dist);

    highp float irisAmount = smoothstep(0.40, 0.85, i);
    highp float irisScale = mix(1.15, 0.95, i);
    highp vec2 hq = vec2((sp.x - ctr.x) / irisScale, (ctr.y - sp.y) / irisScale + 0.5);
    highp float irisD = sdHeart(hq) * irisScale;
    highp float irisRim = smoothstep(0.0, 0.28, irisD) * irisAmount;

    highp float rim = max(max(radial, sideBand), irisRim);
    highp float r = rim * i * beat;

    color = over(color, heartLayer(sp, 0.230, -0.020, 0.30, 0.28, 0.55, 113.0, TIME) * (0.18 * i * mix(0.10, 1.0, rim)));

    color *= 1.0 - 0.90 * r;
    color = mix(color, WINE, 0.55 * r);
    color += ROSE * rim * i * (0.10 + 0.22 * pulse);
    color += ROSE * exp(-abs(irisD) * 9.0) * irisAmount * i * (0.10 + 0.25 * pulse);

    highp float side = 1.0 - smoothstep(0.0, 0.34, min(uv.x, 1.0 - uv.x));
    side *= side;
    highp float rain = side * i * (0.85 + 0.15 * pulse);
    color = over(color, heartLayer(sp, 0.150, 0.045, 0.27, 0.09, 0.55, 3.0, TIME) * rain);
    color = over(color, heartLayer(sp, 0.100, 0.075, 0.21, 0.07, 0.55, 71.0, TIME) * rain);
    color = over(color, heartLayer(sp, 0.066, 0.115, 0.17, 0.06, 0.50, 29.0, TIME) * (rain * 0.9));

    color += GLINT * sparkles(sp, TIME) * side * i;

    color += (hash(uv * vec2(1280.0, 720.0) + fract(TIME) * 53.0) - 0.5) * 0.015 * i;

    COLOR = vec4(clamp(color, 0.0, 1.0), 1.0);
}
